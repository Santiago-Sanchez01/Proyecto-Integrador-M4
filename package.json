{
  "name": "workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "test:rules": "firebase emulators:exec --project demo-workspace-m4 --only firestore \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1170.0",
    "@aws-sdk/credential-provider-web-identity": "3.972.90",
    "@vercel/oidc": "4.0.9",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "google-auth-library": "11.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.36.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "jwks-rsa@4.1.0": {
      "jose": "5.10.0"
    }
  }
}
