# Public Firebase web configuration; copy to .env.local and fill from Firebase Console.
# These VITE_* values are public; server configuration must never use VITE_*.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# SERVER ONLY: explicit development project; this is not a credential.
# ADC must be configured separately, outside this repository and without VITE_*.
# Local impersonated ADC does not require a service-account private key.
# Vercel production needs its own server identity; never upload personal ADC.
FIREBASE_ADMIN_PROJECT_ID=workspace-m4

# Server only. Do not enable real sending until explicitly authorized.
SUMMARY_EMAIL_ENABLED=false
SUMMARY_EMAIL_RUNTIME=disabled
# Future authorized local ALLOW also requires exact VERCEL=1,
# VERCEL_ENV=development, NODE_ENV=development, and no conflicting target.
# Required before parsing any request; this does not authorize sending.
NODEJS_HELPERS=0
AWS_SES_REGION=
SES_FROM_EMAIL=
# Public UI availability only; never authorizes sending on the server.
VITE_SUMMARY_EMAIL_ENABLED=false
