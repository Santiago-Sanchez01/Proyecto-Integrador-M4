rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validTask(data) {
      return data.keys().hasAll(['title', 'description', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'description', 'status', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.trim().size() > 0
        && data.description is string && data.description.trim().size() > 0
        && data.status is string && data.status in ['pending', 'completed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list, delete: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasAll(['focusTaskId'])
        && request.resource.data.keys().hasOnly(['focusTaskId'])
        && (request.resource.data.focusTaskId == null
          || (request.resource.data.focusTaskId is string
            && request.resource.data.focusTaskId.trim().size() > 0
            && request.resource.data.focusTaskId.matches('[^/]+')
            && exists(/databases/$(database)/documents/users/$(uid)/tasks/$(request.resource.data.focusTaskId))
            && getAfter(/databases/$(database)/documents/users/$(uid)/tasks/$(request.resource.data.focusTaskId)).data.status == 'pending'));

      function released(taskId) {
        return !exists(/databases/$(database)/documents/users/$(uid))
          || getAfter(/databases/$(database)/documents/users/$(uid)).data.focusTaskId != taskId;
      }

      match /tasks/{taskId} {
        allow get, list: if isOwner(uid);

        allow create: if isOwner(uid)
          && validTask(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(uid)
          && validTask(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.status == 'pending' || released(taskId));

        allow delete: if isOwner(uid) && released(taskId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
